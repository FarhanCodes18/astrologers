# =====================================================
# AstroGuide - Environment Variables
# =====================================================
# IMPORTANT: Never commit this file to version control!
# Add .env to your .gitignore file.
# =====================================================

# ---- Server Configuration ----
PORT=5000
NODE_ENV=development

# ---- Frontend URL (for CORS) ----
# In production, replace * with your actual domain
FRONTEND_URL=http://localhost:3000

# ---- Razorpay Payment Gateway ----
# Get your keys from: https://dashboard.razorpay.com/app/keys
# Add your Razorpay Key ID here:
RAZORPAY_KEY_ID=rzp_test_YourKeyIDHere

# Add your Razorpay Secret Key here:
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere

# ---- Business Contact Info ----
ASTROLOGER_PHONE=+919999999999
ASTROLOGER_EMAIL=hello@astroguide.in
BUSINESS_NAME=AstroGuide

# ---- Optional: Email Service (e.g., Nodemailer) ----
# Uncomment and fill if you want to send email notifications
# EMAIL_SERVICE=gmail
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-app-password

# ---- Optional: Database (e.g., MongoDB) ----
# Uncomment and fill if you want to persist data
# MONGODB_URI=mongodb://localhost:27017/astroguide
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/astroguide
